# Copy to .env for local development. Never commit the filled-in file.
# In production these are set in the Render dashboard under Environment,
# which takes precedence because load_dotenv() does not override variables
# that are already present in the environment.

# PostgreSQL connection string, e.g. postgresql://USER:PASSWORD@HOST/DBNAME
DATABASE_URL=

# City of Melbourne real-time kerbside sensor API endpoint
REAL_TIME_PARKING_API_URL=
